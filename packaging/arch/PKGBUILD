# Maintainer: Ryan Petris
# Builds the checkout this file lives in (no source download): `cd packaging/arch && makepkg -f`.
# Arch metadata uses a numeric version and a dot before dirty; the binary keeps the Git version.
pkgname=elsewhere
_version=${ELSEWHERE_VERSION:-$(sh "$startdir/../../scripts/version.sh")}
pkgver=${_version#v}
pkgver=${pkgver//-/.}
pkgrel=1
pkgdesc="Headless Wayland compositor whose screen is a browser tab"
arch=('x86_64')
url="https://github.com/ryanpetris/elsewhere"
license=('MIT')
depends=('ffmpeg' 'libva' 'mesa' 'libxkbcommon' 'libpipewire' 'ca-certificates')
makedepends=('cargo' 'nodejs' 'npm' 'clang' 'glib2' 'git' 'make')
optdepends=('xorg-xwayland: X11 clients'
            'ttf-dejavu: titles on the window decorations the compositor draws'
            'pipewire: private native audio services (PipeWire 1.4.2 or later)'
            'pipewire-pulse: Pulse client compatibility in the private session'
            'wireplumber>=0.5.6: private audio routing policy'
            'libpulse: Pulse readiness probe (pactl)'
            'intel-media-driver: VA-API on Intel GPUs'
            'libva-mesa-driver: VA-API on AMD GPUs')
options=('!lto' '!debug') # one package; no split -debug package with the symbols

build() {
    cd "$startdir/../.."
    ELSEWHERE_VERSION="$_version" make build
}

package() {
    cd "$startdir/../.."
    install -Dm755 target/release/elsewhere "$pkgdir/usr/bin/elsewhere"
    install -Dm644 ACKNOWLEDGEMENTS.md "$pkgdir/usr/share/licenses/$pkgname/ACKNOWLEDGEMENTS.md"
    install -Dm644 docs/native-dependencies.md "$pkgdir/usr/share/licenses/$pkgname/native-dependencies.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 docs/audio-visualiser.md "$pkgdir/usr/share/doc/$pkgname/audio-visualiser.md"
    install -Dm644 docs/session-audio.md "$pkgdir/usr/share/doc/$pkgname/session-audio.md"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
